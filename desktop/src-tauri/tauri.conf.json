{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ONEHUB",
  "version": "0.1.0",
  "identifier": "app.onehub.desktop",
  "build": {
    "frontendDist": "../../client/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --dir ../client dev",
    "beforeBuildCommand": "pnpm --dir ../client build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ONEHUB",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "backgroundColor": "#07070A",
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "category": "SocialNetworking",
    "shortDescription": "Gamer-first voice and chat",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}