# Public URL people use to reach ONEHUB (behind your HTTPS reverse proxy)
PUBLIC_URL=https://hub.example.com
# Long random strings: `openssl rand -hex 32`
POSTGRES_PASSWORD=
JWT_SECRET=
# LiveKit credentials: key is any short id, secret at least 32 characters
LIVEKIT_API_KEY=onehub
LIVEKIT_API_SECRET=
# Where clients reach LiveKit (wss:// behind TLS)
LIVEKIT_PUBLIC_URL=wss://voice.example.com
